# 使用本地 nginx:alpine 构建 Python 环境 (修复版)
FROM nginx:alpine AS python-base

# 切换到 root 用户
USER root

# 安装 Python 和依赖
RUN apk add --no-cache \
    python3 \
    python3-dev \
    py3-pip \
    gcc \
    musl-dev \
    libffi-dev \
    openssl-dev \
    curl

# 创建工作目录
WORKDIR /app

# 创建非 root 用户
RUN addgroup -g 1001 appuser && \
    adduser -D -u 1001 -G appuser appuser

# 设置 Python 符号链接
RUN ln -sf python3 /usr/bin/python && \
    ln -sf pip3 /usr/bin/pip

# 升级 pip（使用 --break-system-packages）
RUN pip3 install --break-system-packages --upgrade pip

# 安装通用 Python 依赖（使用 --break-system-packages）
RUN pip3 install --break-system-packages --no-cache-dir \
    fastapi \
    uvicorn \
    sqlalchemy \
    asyncpg \
    redis \
    celery \
    requests

# 设置权限
RUN chown -R appuser:appuser /app

# 切换到非 root 用户
USER appuser

# 验证安装
RUN python --version && pip --version

# 暴露端口
EXPOSE 8000

CMD ["python", "main.py"]
