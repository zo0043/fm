# 紧急方案：使用 Node.js 镜像构建 Python 基础环境
FROM node:18-alpine

# 切换到 root 用户
USER root

# 安装 Python 和依赖
RUN apk add --no-cache \
    python3 \
    python3-dev \
    py3-pip \
    gcc \
    musl-dev \
    libffi-dev \
    openssl-dev \
    && python3 -m pip install --upgrade pip

# 设置 Python 符号链接
RUN ln -sf python3 /usr/bin/python && \
    ln -sf pip3 /usr/bin/pip

# 创建工作目录
WORKDIR /app

# 切换回非 root 用户
USER node

# 验证安装
RUN python --version && pip --version

EXPOSE 8000

CMD ["python", "main.py"]
