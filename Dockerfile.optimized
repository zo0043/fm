# 优化的Python基础镜像 - 内存友好版本
FROM python:3.11-slim AS fund-monitor-base-optimized

# 设置环境变量
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# 安装系统依赖（分批安装）
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# 创建非root用户
RUN useradd --create-home --shell /bin/bash app

# 设置工作目录
WORKDIR /app

# 复制requirements文件（分拆）
COPY backend/requirements.txt /app/requirements.txt
COPY backend/services/*/requirements.txt /app/service-reqs/ 2>/dev/null || true

# 分批安装Python依赖（内存优化）
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --break-system-packages \
    fastapi==0.104.1 \
    uvicorn[standard]==0.24.0 \
    sqlalchemy==2.0.23 \
    pydantic==2.5.0 \
    loguru==0.7.2 \
    python-dotenv==1.0.0 && \
    pip install --no-cache-dir --break-system-packages \
    redis==5.0.1 \
    httpx==0.25.2 \
    aiohttp>=3.11.13 \
    python-dateutil==2.8.2 && \
    pip install --no-cache-dir --break-system-packages \
    pandas==2.1.4 \
    numpy==1.25.2 && \
    pip install --no-cache-dir --break-system-packages \
    celery==5.3.4 \
    yfinance==0.2.28 \
    akshare==1.17.83 && \
    pip install --no-cache-dir --break-system-packages \
    asyncpg==0.29.0 \
    influxdb-client==1.38.0 \
    pytest==7.4.3 \
    && true

# 切换到非root用户
USER app

# 共享库将在Dockerfile.base中复制
# 暴露默认端口
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD python -c "import requests; requests.get('http://localhost:${PORT:-8000}/health', timeout=3)" || exit 1

# 默认命令
CMD ["python", "main.py"]
